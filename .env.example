# Copy to .env (never commit .env).

# Generate with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Where central (API + dashboard) listens on the host. Point your HTTPS reverse
# proxy (nginx, Traefik, Cloudflare Tunnel, tailscale serve, ...) at it. Keep it
# on 127.0.0.1 or a private interface; the dashboard needs HTTPS to log in.
CENTRAL_PORT=127.0.0.1:8080

# URL VMs and browsers use to reach central (the proxy's URL).
CENTRAL_PUBLIC_URL=https://vuln.example.com

# Restrict the dashboard, /api/admin and /mcp to these networks (space- or
# comma-separated CIDRs). Agents (/api/v1) are never restricted. Empty = everyone
# (login still required). Needs CENTRAL_TRUST_PROXY=true behind a proxy.
ADMIN_ALLOW_CIDRS=

# true (default): take the client IP from X-Forwarded-For sent by a proxy on a
# private or loopback address. Set false if clients connect to central directly.
#CENTRAL_TRUST_PROXY=true

# Daily MySQL dump into ./backups at BACKUP_AT (UTC), kept BACKUP_KEEP_DAYS days.
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14
# 1 = also take one backup right after start (to test the setup).
BACKUP_RUN_NOW=0

# One-line agent installer (dashboard: Add agent). VMs download this agent release
# tag from GitHub and enroll against CENTRAL_PUBLIC_URL. Empty disables /install.sh.
CENTRAL_AGENT_VERSION=v0.2.1

# Image tag for the central build.
CENTRAL_VERSION=dev
