{
	email {$ACME_EMAIL}
}

{$CENTRAL_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# The SPA loads only its own assets; inline styles come from the UI library.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	# route keeps these blocks in the written order (plain handle blocks get re-sorted).
	route {
		# Agents: enroll, heartbeat, config, report, and the installer. Open to all VMs.
		@agent path /api/v1/* /healthz /install.sh
		handle @agent {
			reverse_proxy central:8080
		}

		# Dashboard (API + SPA): limited to ADMIN_ALLOW_CIDRS (compose default:
		# everyone; login is still required).
		@blocked not remote_ip {$ADMIN_ALLOW_CIDRS}
		handle @blocked {
			respond "Forbidden" 403
		}
		handle /api/admin/* {
			reverse_proxy central:8080
		}
		handle {
			root * /srv/dashboard
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}
	}
}
