# Copy to .env (never commit .env).

# Public DNS name pointing at this server; Caddy gets a Let's Encrypt certificate for it.
# Use "localhost" for a local test (Caddy then uses its own internal CA).
CENTRAL_DOMAIN=vuln.example.com
ACME_EMAIL=ops@example.com

# Generate with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Restrict the dashboard and /api/admin to these networks (space-separated CIDRs).
# Agents (/api/v1) are never restricted. Default: everyone (login still required).
ADMIN_ALLOW_CIDRS=0.0.0.0/0 ::/0

# Daily MySQL dump into ./backups at BACKUP_AT (UTC), kept BACKUP_KEEP_DAYS days.
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14
# 1 = also take one backup right after start (to test the setup).
BACKUP_RUN_NOW=0

# Host ports for Caddy (change only for local tests when 80/443 are taken).
HTTP_PORT=80
HTTPS_PORT=443

# One-line agent installer (dashboard: Add agent). VMs download this agent release
# tag from GitHub and enroll against CENTRAL_PUBLIC_URL (default https://CENTRAL_DOMAIN;
# set it for VMs that reach central another way, e.g. http://<tailscale-ip>:8080).
# Leave CENTRAL_AGENT_VERSION empty to disable /install.sh.
CENTRAL_AGENT_VERSION=v0.2.0
#CENTRAL_PUBLIC_URL=https://vuln.example.com

# Image tag for central/caddy builds.
CENTRAL_VERSION=dev
